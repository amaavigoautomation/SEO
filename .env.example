# Postgres (Neon / Vercel Postgres / local). Same value on Vercel.
GROWTH_OS_DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# OpenAI text
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-6-astra"
OPENAI_FALLBACK_MODEL="gpt-6-luna"
# (run `npm run check:models` to confirm your key can use these)

# Images: openai | gemini
IMAGE_PROVIDER="openai"
OPENAI_IMAGE_MODEL="gpt-image-2.5-flare"
OPENAI_IMAGE_SIZE="1536x1024"
# Gemini image models need a paid/billing-enabled key
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL=""
GEMINI_IMAGE_ASPECT="16:9"

# Team login (shared password)
APP_PASSWORD="change-me"
AUTH_SECRET="long-random-string"
